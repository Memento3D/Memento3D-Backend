# --- 3D RECONSTRUCTION GPU WORKER / AI DISPATCH ---
AI_BASE_URL=http://localhost:8000
AI_API_KEY=memento3d-internal-ai-key
AI_DISPATCH_ENABLED=false
AI_SYNC_ENABLED=false
AI_EXECUTION_MODE=mock
AI_MOCK_ENABLED=true
AI_MOCK_DELAY_MS=2000

# --- 3D PRINTER FLEET & OCTOPRINT AGENT GATEWAY ---
PRINTER_AGENT_POLL_INTERVAL_SECONDS=5
PRINTER_AGENT_HEARTBEAT_TIMEOUT_SECONDS=45
PRINTER_AGENT_LIVENESS_INTERVAL_MS=15000
PRINTER_AGENT_LIVENESS_ENABLED=true
