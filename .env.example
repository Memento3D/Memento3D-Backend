# ==============================================================================
# MEMENTO3D PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env before starting the backend or docker services.
# DO NOT COMMIT SENSITIVE PRODUCTION CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# --- SERVER RUNTIME ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- DATABASE: POSTGRESQL / NEON ---
DB_HOST=ep-sparkling-union-b5betlay-pooler.c-7.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password_here
SQL_INIT_MODE=never
DDL_AUTO=validate

# --- CACHE & IN-MEMORY STORE: REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000ms

# --- SECURITY & JWT DUAL TOKEN ---
# 256-bit Hex secret key for HS256 JWT signature
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Access token expiration in milliseconds (3600000 ms = 1 hour)
JWT_EXPIRATION=3600000
# Refresh token expiration in seconds (604800 s = 7 days)
JWT_REFRESH_EXPIRATION_SECONDS=604800

# --- GOOGLE OAUTH2 AUTHENTICATION ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect

# --- CORS ALLOWED ORIGINS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# --- CLOUD MEDIA STORAGE (CLOUDINARY) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- PAYMENT INTEGRATION: MOMO GATEWAY ---
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1wa8ngfBW/gahOD0viQDuMmq
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
